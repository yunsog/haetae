  {
   "id": 20,
   "type": "timeseries",
   "title": "Uptime / upgrades",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 12,
    "y": 44,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "refId": "A",
     "expr": "time() - haetae_start_timestamp_seconds{job=\"haetae\", instance=~\"$instance\"}",
